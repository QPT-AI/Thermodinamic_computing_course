%% beamerthemetermo.sty — tema QPT oscuro (docs/brand_manual.md), coherente con las animaciones.
%% Compilar con pdfLaTeX. Sustitutos de las tipografías de marca disponibles en TeX Live:
%% Helvetica (titulares y cuerpo, en lugar de Space Grotesk / Inter) y Latin Modern Mono (en lugar de IBM Plex Mono).
\mode<presentation>
\RequirePackage[scaled=0.95]{helvet}
\RequirePackage[letterspace=140]{microtype}
\RequirePackage{tikz}
\usefonttheme{professionalfonts}
\usefonttheme[onlymath]{serif}
\renewcommand{\familydefault}{\sfdefault}
\newcommand{\qptdisplay}{\sffamily}
\newcommand{\qptmono}{\ttfamily}
\setbeamertemplate{navigation symbols}{}
%% Neutros (modo oscuro) y acentos de paradigma (fijos)
\definecolor{fondo}{HTML}{0B0D0E}
\definecolor{caja}{HTML}{131619}
\definecolor{elevado}{HTML}{191D20}
\definecolor{tx}{HTML}{FFFFFF}
\definecolor{tenue}{HTML}{A2A3A3}
\definecolor{debil}{HTML}{5E5F60}
\definecolor{hairline}{HTML}{2E3032}
\definecolor{quantum}{HTML}{5BAD1E}
\definecolor{photonic}{HTML}{F0AB00}
\definecolor{thermo}{HTML}{E8690A}
\definecolor{ternary}{HTML}{8A8A8A}
\definecolor{bio}{HTML}{1AAB7C}
%% Nombres semánticos del curso (mismo mapa que estilo.py)
\colorlet{energia}{photonic}\colorlet{prob}{quantum}\colorlet{ruido}{thermo}
\colorlet{info}{bio}\colorlet{digital}{ternary}\colorlet{hw}{tx}\colorlet{resalte}{tx}
\setbeamercolor{background canvas}{bg=fondo}
\setbeamercolor{normal text}{fg=tx,bg=fondo}
\setbeamercolor{frametitle}{fg=tx,bg=fondo}
\setbeamercolor{title}{fg=tx}
\setbeamercolor{subtitle}{fg=tenue}
\setbeamercolor{author}{fg=tenue}
\setbeamercolor{date}{fg=tenue}
\setbeamercolor{itemize item}{fg=tenue}
\setbeamercolor{itemize subitem}{fg=debil}
\setbeamercolor{enumerate item}{fg=tenue}
\setbeamercolor{block title}{fg=tx,bg=caja}
\setbeamercolor{block body}{fg=tx,bg=caja}
\setbeamercolor{alerted text}{fg=thermo}
\setbeamercolor{footline}{fg=tenue}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamertemplate{itemize items}{\raisebox{0.25ex}{\tikz\fill[tenue] (0,0) circle (0.11em);}}
\newcommand{\qptceja}[1]{{\qptmono\scriptsize\color{tenue}\textls{\MakeUppercase{#1}}}}
%% Spectrum Line: regla fina de 4 paradas (Quantum → Photonic → Thermodynamic → Bio)
\newcommand{\qptespectro}[1]{\begin{tikzpicture}
  \shade[left color=quantum,right color=photonic] (0,0) rectangle (#1/3,0.045);
  \shade[left color=photonic,right color=thermo] (#1/3,0) rectangle (2*#1/3,0.045);
  \shade[left color=thermo,right color=bio] (2*#1/3,0) rectangle (#1,0.045);\end{tikzpicture}}
\setbeamertemplate{frametitle}{%
  \vspace{0.35cm}\hspace{0.1cm}{\qptdisplay\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}\par
  \vspace{0.05cm}\hspace{0.1cm}{\color{quantum}\rule{0.12\paperwidth}{1pt}}\vspace{0.1cm}}
\setbeamertemplate{footline}{%
  \hbox to \paperwidth{\hspace{0.4cm}\raisebox{-0.1cm}{\includegraphics[height=0.42cm]{qpt_logo.png}}\hspace{0.15cm}%
  {\qptmono\tiny\color{tenue}QPT\enspace·\enspace\insertshorttitle}\hfill{\qptmono\tiny\color{tenue}\insertframenumber}\hspace{0.4cm}}\vspace{0.22cm}}
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node at ([xshift=3.2cm,yshift=0.1cm]current page.west) {\includegraphics[height=4.6cm]{qpt_logo.png}};
    \draw[hairline,line width=1.5pt] ([xshift=0.5cm,yshift=-0.5cm]current page.north west) -- ++(0,-0.5);
    \draw[hairline,line width=1.5pt] ([xshift=0.5cm,yshift=-0.5cm]current page.north west) -- ++(0.5,0);
    \draw[hairline,line width=1.5pt] ([xshift=-0.5cm,yshift=0.5cm]current page.south east) -- ++(0,0.5);
    \draw[hairline,line width=1.5pt] ([xshift=-0.5cm,yshift=0.5cm]current page.south east) -- ++(-0.5,0);
  \end{tikzpicture}%
  \hspace*{5.6cm}\begin{minipage}{0.56\paperwidth}\raggedright
    {\qptdisplay\bfseries\Large QPT}\\[0.05cm]
    {\qptmono\tiny\color{tenue}QUANTUM · PHOTONIC · THERMODYNAMIC}\\[0.55cm]
    {\qptceja{\insertsubtitle}}\\[0.2cm]
    {\qptdisplay\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle}\\[0.35cm]
    \qptespectro{4.2}\\[0.35cm]
    {\qptmono\scriptsize\color{tenue}\insertauthor}\\[0.05cm]
    {\qptmono\scriptsize\color{tenue}\insertdate}
  \end{minipage}}
\setbeamertemplate{blocks}[rounded][shadow=false]
\mode<all>
